PM_ENVIRONMENT=development
PM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost/presentation_maker
PM_REDIS_URL=redis://localhost:6379/0
PM_ALLOWED_ORIGINS=["http://localhost:5173"]
# Явная тестовая фикстура, не реальный ML; в production этот адаптер запрещён.
PM_ML_ADAPTER=fixture
# Реальная интеграция: PM_ML_ADAPTER=module и импортируемый модуль с generate/revise.
PM_ML_MODULE=presentation_ml
PM_MAX_ACTIVE_PER_USER=2
PM_MAX_ACTIVE_JOBS=100
PM_JOB_DEADLINE_SECONDS=1500
# Скользящие квоты за 24 часа: ошибки учитываются, идемпотентные повторы — нет.
PM_MAX_DAILY_JOBS_PER_USER=20
PM_MAX_DAILY_JOBS=500
PM_MAX_PRESENTATIONS_PER_USER=100
PM_MAX_PRESENTATIONS=5000
PM_MAX_JOBS_PER_USER=5000
PM_MAX_JOBS=100000
# В development/test регистрация открыта; в production требуется явное разрешение.
# PM_REGISTRATION_ENABLED=false
# Хосты API в production без схемы и порта; по умолчанию берутся из разрешённых Origin.
# PM_ALLOWED_HOSTS=["api.example.com"]
