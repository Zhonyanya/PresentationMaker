# Режим API: mock — демонстрационный генератор в браузере, http — настоящий бэкенд
VITE_API_MODE=mock

# Базовый URL бэкенда без /api/v1. Пусто — тот же домен; ServerApp использует /api/v1/*.
VITE_API_BASE_URL=

# Только legacy http-api.ts: таймаут синхронного запроса, мс. ServerApp НЕ использует эту переменную.
# В текущем HTTP-режиме запросы ограничены 20 с, генерация идёт через polling Job.
# Общий deadline задаётся на backend: PM_JOB_DEADLINE_SECONDS (не более 1500 с).
VITE_API_TIMEOUT_MS=1500000

# Только для npm run dev: проксировать /api/* на локальный бэкенд, например http://localhost:8000
VITE_DEV_PROXY_TARGET=
