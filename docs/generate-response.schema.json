{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "slides": {
      "minItems": 1,
      "maxItems": 60,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 10000
              },
              "layout": {
                "type": "string",
                "const": "title"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "subtitle": {
                "type": "string",
                "maxLength": 400
              },
              "caption": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "layout",
              "title"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 10000
              },
              "layout": {
                "type": "string",
                "const": "text"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "body": {
                "type": "string",
                "maxLength": 4000
              },
              "sourceMaterial": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "table"
                      },
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 250
                      },
                      "rows": {
                        "minItems": 2,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "minItems": 2,
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 300
                          }
                        }
                      },
                      "merges": {
                        "maxItems": 40,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "row": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9
                            },
                            "column": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 7
                            },
                            "rowspan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10
                            },
                            "colspan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 8
                            }
                          },
                          "required": [
                            "row",
                            "column",
                            "rowspan",
                            "colspan"
                          ]
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "rows"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "image"
                      },
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 250
                      },
                      "png": {
                        "type": "string",
                        "maxLength": 1500000,
                        "pattern": "^data:image\\/png;base64,[A-Za-z0-9+/]+={0,2}$"
                      }
                    },
                    "required": [
                      "kind",
                      "png"
                    ]
                  }
                ]
              },
              "composition": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "comparison"
                      },
                      "categories": {
                        "minItems": 1,
                        "maxItems": 6,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "series": {
                        "minItems": 2,
                        "maxItems": 2,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40
                            },
                            "values": {
                              "minItems": 1,
                              "maxItems": 6,
                              "type": "array",
                              "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1000000000
                              }
                            }
                          },
                          "required": [
                            "label",
                            "values"
                          ]
                        }
                      },
                      "unit": {
                        "type": "string",
                        "const": "%"
                      }
                    },
                    "required": [
                      "kind",
                      "categories",
                      "series"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "metric"
                      },
                      "values": {
                        "minItems": 2,
                        "maxItems": 2,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 20
                            }
                          },
                          "required": [
                            "label",
                            "value"
                          ]
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "values"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "caveats"
                      },
                      "items": {
                        "minItems": 2,
                        "maxItems": 2,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "detail": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 420
                            }
                          },
                          "required": [
                            "title",
                            "detail"
                          ]
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "items"
                    ]
                  }
                ]
              },
              "textStyle": {
                "type": "string",
                "enum": [
                  "lead",
                  "blocks",
                  "steps"
                ]
              }
            },
            "required": [
              "layout",
              "title",
              "body"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 10000
              },
              "layout": {
                "type": "string",
                "const": "bullets"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "bullets": {
                "default": [],
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            },
            "required": [
              "layout",
              "title"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 10000
              },
              "layout": {
                "type": "string",
                "const": "two-column"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "leftTitle": {
                "type": "string",
                "maxLength": 120
              },
              "left": {
                "default": [],
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "rightTitle": {
                "type": "string",
                "maxLength": 120
              },
              "right": {
                "default": [],
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            },
            "required": [
              "layout",
              "title"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 10000
              },
              "layout": {
                "type": "string",
                "const": "section"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "subtitle": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "layout",
              "title"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 10000
              },
              "layout": {
                "type": "string",
                "const": "closing"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "subtitle": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "layout",
              "title"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "title",
    "slides"
  ]
}
