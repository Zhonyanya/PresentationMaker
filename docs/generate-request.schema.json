{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 100,
      "maxLength": 60000
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "slideCount": {
      "type": "integer",
      "minimum": 3,
      "maximum": 20
    }
  },
  "required": [
    "text",
    "slideCount"
  ]
}
