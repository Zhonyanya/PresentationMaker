{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brandbook": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "headingFont": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^<>&\"'\\\\\\x00-\\x1f\\x7f\\ufffe\\uffff]+$"
        },
        "bodyFont": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^<>&\"'\\\\\\x00-\\x1f\\x7f\\ufffe\\uffff]+$"
        }
      },
      "required": [
        "name",
        "primary",
        "accent"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 100,
      "maxLength": 60000
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "slideCount": {
      "type": "integer",
      "minimum": 3,
      "maximum": 20
    }
  },
  "required": [
    "text",
    "slideCount"
  ]
}
